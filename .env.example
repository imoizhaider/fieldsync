# Copy to .env and fill in from the Supabase dashboard (Project settings).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The public key. The only key that is placed in the built app.
SUPABASE_ANON_KEY=
# Secret key. Used only by scripts/seed.mjs. Never shipped to the browser.
SUPABASE_SERVICE_KEY=
# Postgres connection string. Used by scripts/apply-schema.mjs and the tests.
SUPABASE_DB_URL=
